# Скопируйте в .env:  cp .env.example .env

# ---------- окружение ----------
APP_ENV=dev
DEFAULT_TZ=Europe/Moscow
# Зафиксировать «сейчас» (тесты, демо). Пусто — реальное время.
FREEZE_NOW=2026-10-21T14:00:00+03:00

# ---------- безопасность (docs/security/REPORT.md) ----------
# Подпись cookie сессии. В prod обязательно, ≥ 32 символов: openssl rand -hex 32
SESSION_SECRET=
# Демо-пользователи: им одним выдаётся сессия (POST /api/session), создаются при старте
DEMO_USERS=1,2,3
# Переходный режим для prod: принимать X-User-Id, пока фронт не перешёл на /api/session. Потом — false.
ALLOW_HEADER_AUTH=false
# Лимиты частоты: /api/chat+/api/undo на сессию в минуту и на весь сервис в час; /api/tts на пользователя
RATE_CHAT_PER_MIN=20
RATE_SERVICE_PER_HOUR=3000
RATE_TTS_PER_MIN=30
# входов (POST /api/session) в минуту на IP
RATE_LOGIN_PER_MIN=10

# ---------- какие реализации подключены ----------
# По умолчанию — настоящие модули. fake/memory — заглушки каркаса (тесты, отладка без БД)
# fake | real
NLU_IMPL=real
# fake | real
DIALOG_IMPL=real
# memory | postgres
STORAGE_IMPL=postgres
# fake | gigaam | speechkit | browser
STT_PROVIDER=fake
# fake | silero | speechkit | browser
TTS_PROVIDER=fake
# gigachat | yandex | ollama | rules
LLM_PROVIDER=rules

# ---------- голос (чат 4, подробности — backend/app/voice/README.md) ----------
# Модели GigaAM/Silero собираются в образ при VOICE_MODELS=1. Профили (RAM процесса API, 2 vCPU):
#
#   полный, сервер 8 ГБ+ (≈2 ГБ):  VOICE_MODELS=1 STT_PROVIDER=gigaam TTS_PROVIDER=silero
#
#   сервер 4 ГБ, лимит API 1,5 ГБ (≈1,1 ГБ, STT ≈0,3 с на фразу 5 с):
#     VOICE_MODELS=1 GIGAAM_QUANTIZE=int8 TTS_MODELS=0 STT_PROVIDER=gigaam TTS_PROVIDER=none
#     VOICE_TORCH_THREADS=2 VOICE_PARTIALS=0 API_MEM_LIMIT=1500m
#     (int8 готовится при сборке образа: пик сборки ≈2 ГБ; озвучку делает браузер через speechSynthesis)
#
#   без моделей (≈0,1 ГБ): VOICE_MODELS=0 STT_PROVIDER=speechkit TTS_PROVIDER=none
#     + YANDEX_API_KEY и YANDEX_FOLDER_ID ниже (≈0,16 ₽ за распознавание фразы до 15 с)
#
# Профиль сборки — после правки: docker compose build api && docker compose up -d api
VOICE_MODELS=1
GIGAAM_MODEL=v3_e2e_rnnt
# none (fp32) | int8 — квантование энкодера при сборке; ≈2,4× меньше RAM, быстрее на CPU
GIGAAM_QUANTIZE=none
# 0 — не класть Silero в образ (при TTS_PROVIDER=none | speechkit)
TTS_MODELS=1
# потоков torch на распознавание; = числу vCPU, отданных API
VOICE_TORCH_THREADS=4
SILERO_MODEL=v5_6_ru
SILERO_SPEAKER=
SPEECHKIT_VOICE=
# промежуточные транскрипты (только локальный STT); на 2 vCPU лучше 0
VOICE_PARTIALS=1
VOICE_OPUS_BITRATE=
# лимиты голоса (SEC-02/03): одновременных decode+STT и синтезов; ожидание слота, затем «Сервер занят»
VOICE_MAX_CONCURRENCY=2
VOICE_MAX_TTS_CONCURRENCY=2
VOICE_QUEUE_TIMEOUT_S=5
# /ws/voice: сокетов на процесс и на сессию; закрыть после N с тишины; реплик в минуту на сессию
VOICE_MAX_SOCKETS=20
VOICE_MAX_SOCKETS_PER_SESSION=2
VOICE_IDLE_TIMEOUT_S=60
VOICE_MAX_TURNS_PER_MIN=10
# длительность реплики: дольше — обрезается ещё при декодировании
VOICE_MAX_UTTERANCE_S=20

# ---------- ключи провайдеров (никогда не коммитить .env!) ----------
# LLM подключается только когда правила не уверены (< NLU_RULES_THRESHOLD); иначе ответ за ~1 мс без сети.
# GigaChat: ключ авторизации из developers.sber.ru → GigaChat API; сертификат Минцифры — в data/ (см. README)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# true | false | путь к CA Минцифры (в Docker: /app/data/russian_trusted_root_ca.pem)
GIGACHAT_VERIFY_SSL=true
YANDEX_MODEL=yandexgpt-lite
NLU_LLM_TIMEOUT=6
NLU_RULES_THRESHOLD=0.85
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_IAM_TOKEN=
# не задано — лёгкий хеширующий эмбеддер (офлайн, CI); deepvk/USER-bge-m3 — семантика, +~2 ГБ RAM, затем `python -m app.cli reembed`
# EMBEDDINGS_MODEL=deepvk/USER-bge-m3
# словарь синонимов (чат 1); по умолчанию app/nlu/synonyms.yml
# SYNONYMS_PATH=app/nlu/synonyms.yml

# ---------- данные ----------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# В docker-compose DATABASE_URL собирается автоматически; для локального запуска без Docker:
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# CSV для засева InMemoryRepository (в Docker — /app/data/…, локально — ../data/…)
# SEED_CSV=../data/voice_assistant_events_1000.csv
SEED_USER_ID=1
ICS_TOKENS=demo:1

# ---------- веб ----------
CORS_ORIGINS=http://localhost:5173

# ---------- деплой (только на VPS) ----------
# Домен, смотрящий на VPS. Нет своего — используйте <ip-через-дефисы>.sslip.io
DOMAIN=
ACME_EMAIL=
