# 1 — работать на мок-API (бэкенд не нужен). `npm run dev:mock` включает его сам
VITE_USE_MOCK=0
# Куда dev-сервер проксирует /api, /ws, /health, /calendar
VITE_BACKEND_URL=http://localhost:8000
# Зафиксировать «сейчас» для боковой панели «Сегодня / Неделя» (демо, совпадает с FREEZE_NOW бэкенда)
VITE_FREEZE_NOW=
